# NCC IT — environment variables. Copy to frontend/.env (local) or set them in the hosting platform.
# Never commit real values. Every value below is a placeholder.
#
# Everything shown in the app is illustrative: assets, findings, alerts, cases and events come from
# the local simulation and are persisted to the state file (see SIM_DATA_DIR). No real scanner,
# monitoring agent or production system is contacted.

# Required. Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Creates the first administrator when the state has no super admin. There is no default password:
# without SEED_ADMIN_PASSWORD no administrator account exists. Set both, then start the app.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Directory for the persistent simulation state (simulation-state.json). Unset = the workspace root's
# data/ folder. On Railway, point it at the mounted volume, for example /data.
SIM_DATA_DIR=

# Optional. Invitation email is OFF unless every one of these is set AND the build runs in production
# with BREVO_DELIVERY_ENABLED=true. Otherwise invitations are recorded locally with a copyable link.
BREVO_DELIVERY_ENABLED=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional. AI analyst. If unset, AI routes answer "not configured" instead of inventing output.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Leave unset: no Google OAuth client is configured.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=
