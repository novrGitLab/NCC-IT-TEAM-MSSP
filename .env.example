# NovaSOC NCC — local demo environment variables
#
# This app is frontend-only and intentionally never calls a production backend.
# All data is served from the local demo fixture layer (src/lib/demo/).
#
# NEXT_PUBLIC_* is required here (not a plain env var) because the demo login check runs
# client-side in the browser bundle — there is no server auth boundary in this demo build.
# Never put a real credential here; this only gates a client-side demonstration login.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=demo@novasoc-ncc.local
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=demo1234

# Leave unset/false — no Google OAuth client is configured for this demo build.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
