# NCC SOC — local evaluation environment variables
#
# This app has no connection to production security infrastructure. Assets, findings, alerts,
# and events are all generated by the local simulation engine (src/lib/simulation/) and persisted
# to data/simulation-state.json on this machine. Nothing here is a real credential, scanner, or
# customer record.

# Server-only — signs session cookies. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server-only — used ONCE, to create the first super-admin user when the simulation state is
# first seeded. Never sent to the browser. If left unset, the simulation falls back to
# admin@ncc-soc.local / change-me-now (shown on the login screen so a fresh checkout is usable).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Leave unset/false — no Google OAuth client is configured for this evaluation build.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Optional — AI analyst (src/lib/simulation/ai/). Server-only; if unset, AI routes return an
# honest "not configured" response rather than a fabricated answer.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Optional — invite emails (src/lib/simulation/email/). Server-only; if unset, invites fall back
# to a local copyable link instead of claiming an email was sent.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional — overrides where the simulation's data/ directory lives (relative to the project root,
# or an absolute path). Only needed to run a second, fully isolated instance against the same
# checkout (e.g. for verification) without it fighting a dev server already using data/. Leave
# unset for normal use.
SIM_DATA_DIR=
