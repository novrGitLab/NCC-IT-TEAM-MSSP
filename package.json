{
  "name": "ncc-it",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w @ncc-it/frontend",
    "build": "npm run build -w @ncc-it/frontend",
    "start": "node scripts/start-server.mjs",
    "typecheck": "npm run typecheck -w @ncc-it/backend && npm run typecheck -w @ncc-it/frontend",
    "lint": "npm run lint -w @ncc-it/frontend",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "check:nav": "node scripts/check-nav-routes.mjs",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
